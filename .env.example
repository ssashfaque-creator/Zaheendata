# Copy to .env and fill in what you have. Every source is optional: the engine uses whatever is
# configured and tells you what is missing (`zaheen sources`). No paid list vendor is needed:
# long lists come from government registries, Google Maps and public directories.

# --- storage -----------------------------------------------------------------
ZAHEEN_DATABASE_URL=sqlite+aiosqlite:///./data/zaheen.db
# ZAHEEN_DATABASE_URL=postgresql+asyncpg://zaheen:zaheen@localhost:5432/zaheen

# --- Google Maps data (Places API New + Place Details; enable both in Cloud Console) ------
ZAHEEN_GOOGLE_MAPS_API_KEY=

# --- free government keys ------------------------------------------------------
# SAM.gov Entity Management API (NAICS-coded federal registrations + points of contact).
# Free key: https://api.data.gov/signup/
ZAHEEN_SAM_GOV_API_KEY=
# Census County Business Patterns (establishment counts for `zaheen plan`).
# Free key: https://api.census.gov/data/key_signup.html
ZAHEEN_CENSUS_API_KEY=

# --- bulk public datasets --------------------------------------------------------
# SBA PPP loan-level FOIA CSVs (NAICS, address, JobsReported employee count, franchise name).
# `zaheen datasets ppp-download` fills this folder (~8 GB); the first run indexes it per state.
ZAHEEN_PPP_DATA_DIR=./data/ppp
ZAHEEN_PUBLIC_DATASET_REFRESH_DAYS=7

# --- cross-check / review sources --------------------------------------------
ZAHEEN_YELP_API_KEY=
ZAHEEN_ENABLE_OVERPASS=true

# --- experimental browser scraper (read docs/DATA_SOURCES.md first) ----------
ZAHEEN_ENABLE_GOOGLE_MAPS_SCRAPER=false

# --- pipeline thresholds (defaults follow the brief) --------------------------
ZAHEEN_LONG_LIST_TARGET=400
ZAHEEN_SHORT_LIST_TARGET=100
ZAHEEN_MIN_GOOGLE_REVIEWS=10
ZAHEEN_BUSY_REVIEWS_THRESHOLD=50
ZAHEEN_RECENT_REVIEW_WINDOW_DAYS=90
ZAHEEN_EMPLOYEE_MIN=5
ZAHEEN_EMPLOYEE_MAX=19
ZAHEEN_ENFORCE_EMPLOYEE_RANGE=false

# --- politeness ---------------------------------------------------------------
ZAHEEN_USER_AGENT=ZaheendataBot/0.1 (+https://yourdomain.com/bot; business-directory research)
ZAHEEN_RESPECT_ROBOTS_TXT=true
ZAHEEN_GLOBAL_CONCURRENCY=16
ZAHEEN_PER_HOST_REQUESTS_PER_SECOND=1.0
# Stay under Google's starter Places quota (~60 Text Search/min). Raise this after you increase
# the quota in Cloud Console → APIs & Services → Places API (New) → Quotas.
ZAHEEN_GOOGLE_PLACES_REQUESTS_PER_SECOND=0.35
# Default: crawl websites and shortlist first; call Places only on that shortlist.
# Set false to search Places during collect as well. Stop after score for a fully free pass:
#   zaheen campaign run <id> --stop-after score
# then later: zaheen campaign run <id> --start-stage maps
ZAHEEN_DEFER_GOOGLE_PLACES=true
ZAHEEN_GOOGLE_PLACES_SHORTLIST_MULTIPLIER=2
# Free website/address lookups during enrich (DuckDuckGo + OpenStreetMap + SAM/Yelp). 0 disables.
ZAHEEN_WEBSITE_DISCOVER_LIMIT=800

# --- API ----------------------------------------------------------------------
ZAHEEN_API_TOKEN=
ZAHEEN_LOG_LEVEL=INFO
