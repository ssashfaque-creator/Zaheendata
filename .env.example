# Optional. Google Places API (New) Text Search — used only by `zaheendata run`.
# Free inside the 1,000-call monthly Enterprise cap. Not required for
# national Overture downloads.
GOOGLE_MAPS_API_KEY=

# Optional. Census CBP establishment counts by employment size.
CENSUS_API_KEY=

# Optional Socrata app token (higher rate limit on data.texas.gov).
SOCRATA_APP_TOKEN=

# Public Overture Maps Places release. DuckDB reads it from open S3.
OVERTURE_RELEASE=2026-10-21.0

# Local DuckDB warehouse path.
ZAHEENDATA_WAREHOUSE=data/warehouse.duckdb

# Cache directory for API responses and crawled HTML.
ZAHEENDATA_CACHE_DIR=cache
