# Required for discovery (website, reviews, phone, maps profile).
# Places API (New) Text Search Enterprise is used so rating + review
# count come back in the search call. $0 inside the 1,000-call monthly free cap.
GOOGLE_MAPS_API_KEY=

# Optional. Census CBP establishment counts by employment size.
CENSUS_API_KEY=

# Optional Socrata app token (higher rate limit on data.texas.gov).
SOCRATA_APP_TOKEN=

# Cache directory for API responses and crawled HTML.
ZAHEENDATA_CACHE_DIR=cache
